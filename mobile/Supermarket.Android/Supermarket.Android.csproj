<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType><RootNamespace>Supermarket.AndroidApp</RootNamespace>
<UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
<ApplicationTitle>مدار سوفت</ApplicationTitle><ApplicationId>com.supermarket.accounting</ApplicationId>
<ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion><ApplicationVersion>3</ApplicationVersion><SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
<AndroidPackageFormats>apk</AndroidPackageFormats>
<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
<PublishTrimmed>false</PublishTrimmed>
<RunAOTCompilation>false</RunAOTCompilation>
</PropertyGroup>
<ItemGroup>
<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
<PackageReference Include="ZXing.Net" Version="0.16.11"/>
<ProjectReference Include="../../src/Madar.Core/Madar.Core.csproj"/>
<MauiIcon Include="Resources/AppIcon/madar.jpg" Color="#031034" BaseSize="1280,1280"/>
<MauiSplashScreen Include="Resources/Splash/madar.jpg" Color="#031034" BaseSize="180,180"/>
<AndroidAsset Include="www/**/*" />
</ItemGroup>
</Project>
