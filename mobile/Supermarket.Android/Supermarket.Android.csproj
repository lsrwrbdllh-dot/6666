<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType><RootNamespace>Supermarket.AndroidApp</RootNamespace>
<UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
<ApplicationTitle>محاسبة السوبر ماركت</ApplicationTitle><ApplicationId>com.supermarket.accounting</ApplicationId>
<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion><SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
<AndroidPackageFormats>apk</AndroidPackageFormats>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)'=='Debug'"><AndroidManifest>Platforms/Android/AndroidManifest.Debug.xml</AndroidManifest></PropertyGroup>
<ItemGroup>
<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
<ProjectReference Include="../../src/Supermarket.Contracts/Supermarket.Contracts.csproj"/>
<MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#125C60"/>
<MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#125C60" BaseSize="128,128"/>
</ItemGroup>
</Project>
